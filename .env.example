# Copy to .env for local development. On Vercel, add the same variable in
# Project Settings -> Environment Variables (Production / Preview / Development).
#
# MongoDB Atlas connection string used by the /api/* server routes.
# Without it the app runs in demo mode: /api/nurses returns sample nurses and
# nothing is persisted.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nurseconnect

# Only used by the standalone Express app in server/ (`node server/server.js`).
# The deployed Vercel app serves /api/* itself and does not need a port.
PORT=5000
